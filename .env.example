# Fokus DE(E:\Coding\Basiswortschatz)의 .env 와 같은 값을 넣는다.
# 같은 Supabase 프로젝트 → 같은 계정 → 같은 user_id → DE 문장·단어가 그대로 보인다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 다른 Fokus 앱으로 건너가기 (선택) ─────────────────────────────────────────
# 비워 두면 Fokus DE 는 https://basiswortschatz.vercel.app 를 쓰고,
# Karten 은 주소를 모르므로 바로가기 버튼을 숨긴다.
# VITE_FOKUS_DE_URL=
# VITE_KARTEN_URL=

# ── AI 교정 (CP2부터) ────────────────────────────────────────────────────────
# 키는 여기 없다. Fokus DE 의 Supabase 함수 `anthropic` 이 이미 비밀값으로 들고 있다.
# 아래는 키가 아니라 설정값이라 VITE_ 여도 괜찮다.
# VITE_ALLTAG_AI_MODEL=claude-sonnet-5
# VITE_ALLTAG_MONTHLY_CAP_USD=3
